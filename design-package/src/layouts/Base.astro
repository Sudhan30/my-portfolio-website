---
import '../styles/global.css';
import '../styles/resume-stories.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import { site } from '../content/site';
interface Props { title?: string; description?: string; }
const { title = 'Sudharsana — a playful studio for serious engineering', description = 'AI systems, engineering decisions, and things made by Sudharsana Rajasekaran.' } = Astro.props;
const production = process.env.SITE_BUILD_MODE === 'production';
const canonical = new URL(Astro.url.pathname, 'https://sudharsana.dev').href;
const structuredData = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical,
  author: { '@type': 'Person', name: site.fullName, url: 'https://sudharsana.dev/', sameAs: [site.linkedin, site.github] } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={production && !Astro.url.pathname.includes('404') && !Astro.url.pathname.startsWith('/design/') ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#F5F1E8" />
    <title>{title}</title>
    {production && <>
      <link rel="canonical" href={canonical} />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content={site.name} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonical} />
      <meta property="og:image" content="https://sudharsana.dev/social.png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Sudharsana — Curious by nature. A builder by choice. Data foundations and applied AI." />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content="https://sudharsana.dev/social.png" />
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Sudharsana, home"><span class="brand-mark" aria-hidden="true">✳</span> {site.name}<span class="wordmark-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a><a href="/#notes">Notes</a><a href="/#about">About</a><a class="nav-connect" href="/#connect">Let’s talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <a class="wordmark" href="/">Sudharsana.</a>
      <p>Made with curiosity &amp; a little intention.</p>
      <a href={site.github}>More on GitHub ↗</a>
    </footer>
  </body>
</html>
