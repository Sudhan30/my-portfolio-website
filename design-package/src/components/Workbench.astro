---
import { inferenceStates, type InferenceState } from '../content/inference';
interface Props { id?: string; selected?: InferenceState; }
const { id = 'inference', selected = 'one' } = Astro.props;
---
<div class="workbench" data-workbench>
  <fieldset>
    <legend>Follow a request</legend>
    <p class="workbench-intro">A conceptual sketch of inference tradeoffs.</p>
    <div class="scenario-controls">
      {inferenceStates.map((state) => <label class="scenario-choice"><input type="radio" name={id} value={state.id} checked={state.id === selected} aria-controls={`${id}-figure ${id}-${state.id}`} /> <span>{state.label}</span></label>)}
    </div>
  </fieldset>
  <figure id={`${id}-figure`}>
    <svg viewBox="0 0 600 320" role="img" aria-label="Requests move through prompt processing and token generation to a response. A busy queue adds waiting; a shared prefix reuses cached prompt computation.">
      <defs><pattern id={`${id}-dots`} width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="#17211B" opacity=".15"/></pattern></defs>
      <rect width="600" height="320" fill={`url(#${id}-dots)`}/>
      <path d="M152 92h56M392 92h56M507 134v76H330" fill="none" stroke="#17211B" stroke-width="2" stroke-dasharray="5 6"/>
      <path d="M201 87l7 5-7 5M441 87l7 5-7 5M339 205l-8 5 8 5" fill="none" stroke="#17211B" stroke-width="2"/>
      <g class="scenario-layer" data-scenario="one"><rect x="33" y="50" width="120" height="84" rx="18" fill="#F5F1E8" stroke="#17211B" stroke-width="2"/><text x="93" y="86" text-anchor="middle" font-size="19">One</text><text x="93" y="111" text-anchor="middle" font-size="19">request</text></g>
      <g class="scenario-layer" data-scenario="queue"><rect x="18" y="36" width="120" height="84" rx="18" fill="#F5F1E8" stroke="#17211B" stroke-width="2"/><rect x="25" y="43" width="120" height="84" rx="18" fill="#F58B70" stroke="#17211B" stroke-width="2"/><rect x="33" y="50" width="120" height="84" rx="18" fill="#F5F1E8" stroke="#17211B" stroke-width="2"/><text x="93" y="86" text-anchor="middle" font-size="19">Requests</text><text x="93" y="111" text-anchor="middle" font-size="19">may wait</text></g>
      <g class="scenario-layer" data-scenario="prefix"><rect x="33" y="50" width="120" height="84" rx="18" fill="#D6EB77" stroke="#17211B" stroke-width="2"/><text x="93" y="86" text-anchor="middle" font-size="19">Shared</text><text x="93" y="111" text-anchor="middle" font-size="19">prefix</text></g>
      <rect x="208" y="50" width="184" height="84" rx="18" fill="#D6EB77" stroke="#17211B" stroke-width="2"/>
      <text x="300" y="83" text-anchor="middle" font-size="19">Prompt processing</text><text x="300" y="111" text-anchor="middle" font-size="17">prefill</text>
      <rect x="448" y="50" width="120" height="84" rx="18" fill="#17211B"/>
      <text x="508" y="84" text-anchor="middle" font-size="19" fill="#F5F1E8">Generate</text><text x="508" y="111" text-anchor="middle" font-size="17" fill="#F5F1E8">decode</text>
      <g class="scenario-layer" data-scenario="one"><rect x="152" y="184" width="178" height="58" rx="16" fill="#F58B70" stroke="#17211B" stroke-width="2"/><text x="241" y="220" text-anchor="middle" font-size="20">Response</text></g>
      <g class="scenario-layer" data-scenario="queue"><rect x="145" y="172" width="178" height="58" rx="16" fill="#F5F1E8" stroke="#17211B" stroke-width="2"/><rect x="152" y="184" width="178" height="58" rx="16" fill="#F58B70" stroke="#17211B" stroke-width="2"/><text x="241" y="220" text-anchor="middle" font-size="20">Responses</text><text x="430" y="274" text-anchor="middle" font-size="17">Shared batch work</text></g>
      <g class="scenario-layer" data-scenario="prefix"><rect x="152" y="184" width="178" height="58" rx="16" fill="#F58B70" stroke="#17211B" stroke-width="2"/><text x="241" y="220" text-anchor="middle" font-size="20">New response</text><rect x="354" y="244" width="208" height="40" rx="12" fill="#D6EB77" stroke="#17211B" stroke-width="2"/><text x="458" y="270" text-anchor="middle" font-size="17">Cached prefix state</text><path d="M390 245l-39-108" stroke="#17211B" stroke-width="2" stroke-dasharray="5 6"/></g>
      <circle class="request-dot" cx="179" cy="92" r="8" fill="#2448C6" stroke="#F5F1E8" stroke-width="2"/>
      <text x="35" y="294" font-size="14">Illustration, not a benchmark.</text>
    </svg>
    <figcaption>A serving system makes choices about compute, waiting, and reuse.</figcaption>
  </figure>
  <div class="scenario-explanations" aria-live="polite" aria-atomic="true">
    {inferenceStates.map((state) => <section class="scenario-explanation" id={`${id}-${state.id}`} data-explanation={state.id}><h3>{state.heading}</h3><p>{state.explanation}</p><p class="tradeoff">{state.tradeoff}</p></section>)}
  </div>
</div>
<script>
  import '../scripts/workbench';
</script>
