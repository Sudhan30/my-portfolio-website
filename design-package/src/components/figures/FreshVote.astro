---
import Playable from '../Playable.astro';
import { scenarios, customPanel, ages, policies, verdict, type SignalId } from '../../content/figures/fresh-vote';
import '../../styles/figures/fresh-vote.css';

// The server renders the first scenario's settled state, so the figure reads
// correctly before (or without) the script.
const first = scenarios[0];
const initial = verdict(first.probe);
const ageIndex = ages.findIndex((age) => age.seconds === first.probe.ageSeconds);
const tiles: { id: SignalId; name: string; detail: string }[] = [
  { id: 'headers', name: 'Cache headers', detail: 'weight 0.9' },
  { id: 'fingerprint', name: 'Fingerprint', detail: 'weight 0.8' },
  { id: 'liveness', name: 'Liveness', detail: 'weight 0.7' },
  { id: 'policy', name: 'Policy max age', detail: 'weight 0.95' },
];
const tileY = (index: number) => 24 + index * 60;
const stampFill = { FRESH: '#D6EB77', STALE: '#F58B70', UNKNOWN: '#F5F1E8' } as const;
---
<Playable id="fv" kind="fresh-vote" surface="probe"
  legend="Is this response fresh?"
  intro="Four signals vote on one response. Pick a case, or set the inputs yourself and watch the verdict move."
  caption="The vote, thresholds and confidence weights are ported from freshprobe's open source verdict code. The endpoint is illustrative."
  scenarios={scenarios} panels={[customPanel]}>
  <svg viewBox="0 0 600 490" role="img" aria-labelledby="fv-svg-title">
    <title id="fv-svg-title">A response returns HTTP 200. Four signals (cache headers, content fingerprint, liveness and the policy's maximum age) each vote fresh or stale, and the share of fresh votes decides FRESH, STALE or UNKNOWN.</title>
    <defs>
      <pattern id="fv-dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="#17211B" opacity=".14" /></pattern>
      <clipPath id="fv-bar-clip"><rect x="16" y="320" width="568" height="44" rx="22" /></clipPath>
    </defs>
    <rect width="600" height="490" fill="url(#fv-dots)" />

    <g transform="rotate(-2 150 140)">
      <rect x="16" y="24" width="268" height="232" rx="18" fill="#F5F1E8" stroke="#17211B" stroke-width="2" />
      <path d="M16 62h268" stroke="#17211B" stroke-width="2" />
      <circle cx="38" cy="43" r="6" fill="#F58B70" /><circle cx="58" cy="43" r="6" fill="#D6EB77" />
      <text x="34" y="108" font-size="30" font-weight="600">HTTP 200 OK</text>
      <text x="34" y="152" font-size="20">Age</text><text x="266" y="152" font-size="22" font-weight="600" text-anchor="end" data-out="age">{ages[ageIndex]?.label}</text>
      <text x="34" y="196" font-size="20">Body</text><text x="266" y="196" font-size="22" font-weight="600" text-anchor="end" data-out="body">{first.probe.bodyChanging ? 'changes' : 'never changes'}</text>
      <text x="34" y="240" font-size="20">Latency</text><text x="266" y="240" font-size="22" font-weight="600" text-anchor="end" data-out="latency">{first.probe.healthy ? 'steady' : 'spiky'}</text>
    </g>

    {tiles.map((_, index) => <path d={`M286 146 C302 146 300 ${tileY(index) + 28} 316 ${tileY(index) + 28}`} fill="none" stroke="#17211B" stroke-width="2" stroke-dasharray="6 6" />)}
    {tiles.map((tile, index) => <g class="fv-tile" data-signal={tile.id} data-vote={initial.signals[tile.id] ? 'fresh' : 'stale'}>
      <rect x="316" y={tileY(index)} width="268" height="56" rx="14" fill="#F5F1E8" stroke="#17211B" stroke-width="2" />
      <text x="332" y={tileY(index) + 26} font-size="21" font-weight="600">{tile.name}</text>
      <text x="332" y={tileY(index) + 47} font-size="17">{tile.detail}</text>
      <rect class="fv-pill" x="492" y={tileY(index) + 12} width="80" height="32" rx="16" stroke="#17211B" stroke-width="2" data-fade />
      <text class="fv-pill-text" x="532" y={tileY(index) + 34} font-size="18" font-weight="600" text-anchor="middle">{initial.signals[tile.id] ? 'fresh' : 'stale'}</text>
    </g>)}
    {tiles.map((_, index) => <g class="fv-pulse" data-pulse={index}><circle cx="290" cy="146" r="7" fill="#2448C6" stroke="#F5F1E8" stroke-width="2" /></g>)}

    <text x="16" y="306" font-size="22" font-weight="600">Votes</text>
    <text x="584" y="306" font-size="22" text-anchor="end" data-out="tally">{initial.fresh} of 4 fresh</text>
    <rect x="16" y="320" width="568" height="44" rx="22" fill="#F5F1E8" />
    <g clip-path="url(#fv-bar-clip)">
      {[0, 1, 2, 3].map((index) => <rect class="fv-seg" data-seg={index} x={16 + index * 142} y="320" width="142" height="44" fill={index < initial.fresh ? '#D6EB77' : '#F5F1E8'} />)}
    </g>
    <path d="M158 320v44M300 320v44M442 320v44" stroke="#17211B" stroke-width="1" opacity=".35" />
    <rect x="16" y="320" width="568" height="44" rx="22" fill="none" stroke="#17211B" stroke-width="2" />
    <path d="M186.4 312v60M413.6 312v60" stroke="#2448C6" stroke-width="2" stroke-dasharray="4 4" />
    <text x="186.4" y="392" font-size="18" text-anchor="middle" fill="#2448C6">30%</text>
    <text x="413.6" y="392" font-size="18" text-anchor="middle" fill="#2448C6">70%</text>

    <g class="fv-stamp" data-verdict={initial.verdict}>
      <rect x="16" y="414" width="200" height="60" rx="14" fill={stampFill[initial.verdict]} stroke="#17211B" stroke-width="2" data-fade />
      <text x="116" y="455" font-size="30" font-weight="600" text-anchor="middle" data-out="verdict">{initial.verdict}</text>
    </g>
    <text x="236" y="452" font-size="24" data-out="confidence">confidence {initial.confidence.toFixed(2)}</text>
  </svg>
  <div class="fv-controls">
    <label class="fv-field"><span>Data age</span><input type="range" min="0" max={ages.length - 1} step="1" value={ageIndex} data-in="age" aria-valuetext={ages[ageIndex]?.label} /><output data-out="age-value">{ages[ageIndex]?.label}</output></label>
    <label class="fv-field"><span>Policy</span><select data-in="policy">{Object.entries(policies).map(([id, policy]) => <option value={id} selected={id === first.probe.policy}>{policy.label} · {policy.maxSeconds >= 3600 ? `${policy.maxSeconds / 3600}h` : policy.maxSeconds >= 60 ? `${policy.maxSeconds / 60}m` : `${policy.maxSeconds}s`}</option>)}</select></label>
    <label class="fv-check"><input type="checkbox" data-in="body" checked={first.probe.bodyChanging} /> Body changes between polls</label>
    <label class="fv-check"><input type="checkbox" data-in="healthy" checked={first.probe.healthy} /> Latency steady</label>
    <p class="fv-readout" aria-live="polite" data-out="readout">{initial.fresh} of 4 signals fresh: {initial.verdict}, confidence {initial.confidence.toFixed(2)}.</p>
  </div>
</Playable>
<script>
  import '../../scripts/figures/fresh-vote';
</script>
