---
import Playable from '../Playable.astro';
import { scenarios, sources, sourceY } from '../../content/figures/severity-gate';
import '../../styles/figures/severity-gate.css';

const first = scenarios[0];
const stats = [
  { id: 'high', label: 'HIGH' },
  { id: 'medium', label: 'MEDIUM' },
  { id: 'blind', label: 'BLIND' },
  { id: 'emailed', label: 'Emailed now' },
] as const;
---
<Playable id="sg" kind="severity-gate" surface="sentinel"
  legend="Who decides how serious it is?"
  intro="Events flow in from every source. Pick a situation and watch where each one goes, and who is allowed to touch it."
  caption="A sketch of the principles behind Argus, my homelab’s security monitor. Every event shown is synthetic; real rules and sources are deliberately left out."
  scenarios={scenarios}>
  <svg viewBox="0 0 600 540" role="img" aria-labelledby="sg-svg-title">
    <title id="sg-svg-title">Events from logs, metrics, sign-ins and cloud accounts pass through fixed rules that set severity. HIGH findings go straight to email on a locked path. MEDIUM findings are batched, and by design a model may only add a note. An off-site sentry emails directly if the monitor goes silent.</title>
    <defs><pattern id="sg-dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="#17211B" opacity=".14" /></pattern></defs>
    <rect width="600" height="540" fill="url(#sg-dots)" />

    {sources.map((_, index) => <path d={`M172 ${sourceY(index) + 27} C192 ${sourceY(index) + 27} 190 141 210 141`} fill="none" stroke="#17211B" stroke-width="2" stroke-dasharray="6 6" />)}
    <path d="M360 100 C382 100 382 68 404 68M360 180 C382 180 382 176 404 176" fill="none" stroke="#17211B" stroke-width="2" stroke-dasharray="6 6" />
    <path d="M494 220v16" fill="none" stroke="#2448C6" stroke-width="2" stroke-dasharray="4 4" />

    {sources.map((source, index) => {
      const blind = (first.blind as readonly string[]).includes(source.id);
      return <g class="sg-source" data-source={source.id} data-state={blind ? 'blind' : 'ok'}>
        <rect x="16" y={sourceY(index)} width="156" height="54" rx="14" stroke="#17211B" stroke-width="2" data-fade />
        <text x="32" y={sourceY(index) + 25} font-size="22" font-weight="600">{source.label}</text>
        <text x="32" y={sourceY(index) + 45} font-size="17" data-out="status">{blind ? 'BLIND' : 'read ok'}</text>
      </g>;
    })}

    <rect x="216" y="62" width="150" height="170" rx="22" fill="#17211B" />
    <rect x="210" y="56" width="150" height="170" rx="22" fill="#D6EB77" stroke="#17211B" stroke-width="2" />
    <text x="285" y="128" font-size="28" font-weight="600" text-anchor="middle">Rules</text>
    <text x="285" y="158" font-size="18" text-anchor="middle">set every</text>
    <text x="285" y="180" font-size="18" text-anchor="middle">severity</text>

    <g class="sg-lane" data-lane="high">
      <rect x="404" y="24" width="180" height="88" rx="18" fill="#F58B70" stroke="#17211B" stroke-width="2" />
      <text x="422" y="60" font-size="24" font-weight="600">HIGH</text>
      <text x="422" y="92" font-size="18">email now</text>
      <g transform="translate(538 34)"><path d="M5 14v-5a8 8 0 0 1 16 0v5" fill="none" stroke="#17211B" stroke-width="2.5" /><rect x="0" y="14" width="26" height="20" rx="4" fill="#F5F1E8" stroke="#17211B" stroke-width="2" /><circle cx="13" cy="23" r="2.5" fill="#17211B" /></g>
      <text x="551" y="92" font-size="17" text-anchor="middle">locked</text>
    </g>
    <g class="sg-lane" data-lane="medium">
      <rect x="404" y="132" width="180" height="88" rx="18" fill="#F5F1E8" stroke="#17211B" stroke-width="2" />
      <text x="422" y="168" font-size="24" font-weight="600">MEDIUM</text>
      <text x="422" y="200" font-size="18">batched</text>
    </g>
    <g class="sg-model" data-active={first.modelNote ? 'true' : 'false'}>
      <rect x="420" y="236" width="164" height="56" rx="12" fill="#F5F1E8" stroke="#2448C6" stroke-width="2" stroke-dasharray="5 4" data-fade />
      <text x="502" y="260" font-size="18" text-anchor="middle" fill="#2448C6">model note</text>
      <text x="502" y="282" font-size="17" text-anchor="middle" fill="#2448C6">by design</text>
    </g>

    <g class="sg-brain" data-state={first.brainSilent ? 'silent' : 'alive'}>
      <rect x="16" y="314" width="200" height="72" rx="16" fill="#F5F1E8" stroke="#17211B" stroke-width="2" data-fade />
      <text x="34" y="346" font-size="24" font-weight="600">Brain</text>
      <text x="34" y="372" font-size="17" data-out="brain">{first.brainSilent ? 'silent' : 'in the cluster'}</text>
    </g>
    <path class="sg-beat" data-beat="alive" d="M216 350h44l10-18 14 36 12-28 8 10h80" fill="none" stroke="#2448C6" stroke-width="2.5" stroke-linejoin="round" display={first.brainSilent ? 'none' : undefined} />
    <path class="sg-beat" data-beat="silent" d="M216 350h168" fill="none" stroke="#17211B" stroke-width="2" stroke-dasharray="3 7" display={first.brainSilent ? undefined : 'none'} />
    <g class="sg-pulse"><circle cx="216" cy="350" r="6" fill="#2448C6" stroke="#F5F1E8" stroke-width="2" /></g>
    <g class="sg-sentry">
      <rect x="384" y="314" width="200" height="72" rx="16" fill="#F5F1E8" stroke="#17211B" stroke-width="2" />
      <text x="402" y="346" font-size="24" font-weight="600">Sentry</text>
      <text x="402" y="372" font-size="17">off site</text>
      <g class="sg-mail" display={first.brainSilent ? undefined : 'none'}><rect x="526" y="330" width="44" height="32" rx="4" fill="#F58B70" stroke="#17211B" stroke-width="2" /><path d="M526 332l22 16 22-16" fill="none" stroke="#17211B" stroke-width="2" /></g>
    </g>

    {stats.map((stat, index) => <g class="sg-stat" data-stat={stat.id}>
      <rect x={16 + index * 144} y="410" width="136" height="114" rx="16" fill="#F5F1E8" stroke="#17211B" stroke-width="2" />
      <text x={32 + index * 144} y="454" font-size="34" font-weight="600" data-out={`stat-${stat.id}`}>{first.stats[stat.id]}</text>
      <text x={32 + index * 144} y="482" font-size="18">{stat.label}</text>
      {stat.id === 'emailed' && <text x={32 + index * 144} y="506" font-size="17" data-out="emailed-by">{first.stats.emailedBy}</text>}
    </g>)}

    {[0, 1, 2].map((index) => <g class="sg-token" data-token={index}><circle cx="0" cy="0" r="8" fill="#2448C6" stroke="#F5F1E8" stroke-width="2" /></g>)}
  </svg>
</Playable>
<script>
  import '../../scripts/figures/severity-gate';
</script>
