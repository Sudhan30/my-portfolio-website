---
import Playable from '../Playable.astro';
import { steps, nights, silent, scenarios } from '../../content/figures/verified-backup';
import '../../styles/figures/verified-backup.css';

// The server renders the first scenario's settled state, so the figure reads
// correctly before (or without) the script.
const night = nights.good!;
const rowY = (index: number) => 20 + index * 70;
const pillText = { pass: 'pass', fail: 'fail', skip: 'skipped' } as const;
---
<Playable id="vb" kind="verified-backup" surface="platform"
  legend="Check last night’s backup"
  intro="Every morning a job restores one database from the backup and checks the result. Pick a night and watch which check catches what."
  caption="The steps, thresholds and the 483 count come from the homelab’s own pipeline code. Database names are left out."
  scenarios={scenarios}>
  <svg viewBox="0 0 600 470" role="img" aria-labelledby="vb-svg-title">
    <title id="vb-svg-title">Five checks run in order on last night's database dump: freshness, integrity, a real restore into a scratch database, a row count comparison with live, and cleanup. A failed check raises an alert. A second view shows a different job whose alerts went to a deleted service, so 483 failures in a row went unheard until alerts were moved to a channel a person reads.</title>
    <defs><pattern id="vb-dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="#17211B" opacity=".14" /></pattern></defs>
    <rect width="600" height="470" fill="url(#vb-dots)" />

    <g class="vb-steps">
      {steps.map((step, index) => <g class="vb-step" data-step={step.id} data-state={night.states[step.id]}>
        <rect class="vb-row" x="16" y={rowY(index)} width="568" height="60" rx="14" stroke="#17211B" stroke-width="2" data-fade />
        <circle cx="48" cy={rowY(index) + 30} r="16" fill="#F5F1E8" stroke="#17211B" stroke-width="2" />
        <text x="48" y={rowY(index) + 36} font-size="18" font-weight="600" text-anchor="middle">{index + 1}</text>
        <text x="78" y={rowY(index) + 27} font-size="22" font-weight="600">{step.label}</text>
        <text class="vb-detail" x="78" y={rowY(index) + 50} font-size="17">{night.details?.[step.id] ?? step.detail}</text>
        <rect class="vb-pill" x="486" y={rowY(index) + 14} width="84" height="32" rx="16" stroke="#17211B" stroke-width="2" data-fade />
        <text class="vb-pill-text" x="528" y={rowY(index) + 36} font-size="18" font-weight="600" text-anchor="middle">{pillText[night.states[step.id]]}</text>
      </g>)}
    </g>

    <g class="vb-silent">
      <rect x="16" y="20" width="260" height="100" rx="16" fill="#F5F1E8" stroke="#17211B" stroke-width="2" />
      <text x="34" y="60" font-size="22" font-weight="600">Comment summaries</text>
      <text x="34" y="90" font-size="17">a nightly job</text>
      <rect x="16" y="140" width="260" height="220" rx="16" fill="#F58B70" stroke="#17211B" stroke-width="2" />
      <text x="146" y="266" font-size="84" font-weight="600" text-anchor="middle" data-out="count">{silent.failures}</text>
      <text x="146" y="304" font-size="20" text-anchor="middle">failures in a row</text>
      <text x="146" y="334" font-size="17" text-anchor="middle">March to August</text>
      <g class="vb-before">
        <path d="M276 70h48" stroke="#17211B" stroke-width="2" stroke-dasharray="6 6" />
        <path d="M292 60l16 20M308 60l-16 20" stroke="#F58B70" stroke-width="3" stroke-linecap="round" />
        <rect x="324" y="20" width="260" height="140" rx="16" fill="#F5F1E8" stroke="#17211B" stroke-width="2" stroke-dasharray="7 6" />
        <text x="342" y="52" font-size="17">Before</text>
        <text x="342" y="88" font-size="22" font-weight="600">Alert service</text>
        <text x="342" y="116" font-size="17">deleted from the cluster,</text>
        <text x="342" y="140" font-size="17">so nobody heard</text>
      </g>
      <g class="vb-now">
        <path d="M276 250h28v28h14" fill="none" stroke="#17211B" stroke-width="2" />
        <path d="M312 272l7 6-7 6" fill="none" stroke="#17211B" stroke-width="2" />
        <rect x="324" y="196" width="260" height="164" rx="16" fill="#D6EB77" stroke="#17211B" stroke-width="2" />
        <text x="342" y="228" font-size="17">Now</text>
        <text x="342" y="264" font-size="22" font-weight="600">A channel I read</text>
        <text x="342" y="294" font-size="17">every failure reaches</text>
        <text x="342" y="318" font-size="17">a person who can act</text>
      </g>
    </g>

    <g class="vb-outcome" data-tone={night.outcome.tone}>
      <rect class="vb-outcome-box" x="16" y="388" width="568" height="64" rx="16" stroke="#17211B" stroke-width="2" data-fade />
      <path d="M38 406h40v28H38zM38 406l20 15 20-15" fill="#F5F1E8" stroke="#17211B" stroke-width="2" stroke-linejoin="round" />
      <text x="96" y="428" font-size="22" font-weight="600" data-out="outcome">{night.outcome.text}</text>
    </g>
  </svg>
</Playable>
<script>
  import '../../scripts/figures/verified-backup';
</script>
