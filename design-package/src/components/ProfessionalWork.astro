---
import type { CollectionEntry } from 'astro:content';
import WorkArt from './WorkArt.astro';
interface Props { stories: CollectionEntry<'work'>[]; }
const { stories } = Astro.props;
---
<section id="work" class="wrap section-space professional-section" aria-labelledby="professional-title">
  <div class="section-heading">
    <div><p class="eyebrow">Where the work meets the world</p><h2 id="professional-title">Real problems.<br/><em>Useful systems.</em></h2></div>
    <p>Data foundations, applied AI,<br/>and the people who use them.</p>
  </div>
  <div class="professional-grid">
    {stories.map((story,index) => <article class={`professional-card ${index === 0 ? 'professional-card--lead' : ''}`}>
      <div class="professional-card-top"><span class="project-index">{String(index+1).padStart(2,'0')}</span><p>{story.data.category}</p><span aria-hidden="true">↗</span></div>
      <figure class={`professional-art surface-${story.data.illustration}`}><WorkArt kind={story.data.illustration}/></figure>
      <div class="professional-copy">
        <p class="eyebrow">Walmart Global Tech</p>
        <h3><a href={`/work/${story.id}/`}>{story.data.title}</a></h3>
        <p>{story.data.summary}</p>
        {index === 0 && <p class="work-decision">{story.data.decision}</p>}
        {story.data.metrics.length > 0 && <dl class="project-metrics">{story.data.metrics.map(metric => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>}
        <a class="text-link" href={`/work/${story.id}/`}>Read the work story <span aria-hidden="true">↗</span></a>
      </div>
    </article>)}
  </div>
  <p class="source-caption">Professional scope and outcomes are described in my DE and FDE résumés. Stories keep project details at a high level.</p>
</section>
