---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkArt from '../../components/WorkArt.astro';
export async function getStaticPaths() {
  return (await getCollection('work')).map(story => ({params:{slug:story.id},props:{story}}));
}
interface Props { story: CollectionEntry<'work'>; }
const { story } = Astro.props;
const { Content } = await render(story);
---
<Base title={`${story.data.title} — Sudharsana`} description={story.data.subtitle}>
  <article class="story wrap">
    <a class="text-link" href="/#work">← Back to selected work</a>
    <header class="story-header"><p class="eyebrow">Work story · draft for factual review</p><h1>{story.data.title}</h1><p class="large-prose">{story.data.subtitle}</p><p class="small-note">Based on an article published <time datetime={story.data.date}>{story.data.date}</time>.</p></header>
    <figure class="story-art surface-chat"><WorkArt kind={story.data.illustration}/><figcaption>Conceptual illustration: earlier dialogue and recent messages contribute to the context sent to the model.</figcaption></figure>
    <div class="story-body"><Content/><aside class="evidence-note"><h2>Follow the evidence</h2><p>This draft describes the public article, with no claim about current production readiness or measured performance.</p><a class="text-link" href={story.data.source}>{story.data.sourceLabel} ↗</a></aside></div>
    <div class="story-end"><p>Good systems start with good questions.</p><a class="text-link" href="/#connect">Let’s talk ↗</a></div>
  </article>
</Base>
