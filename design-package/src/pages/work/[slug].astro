---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkArt from '../../components/WorkArt.astro';
export async function getStaticPaths() {
  return (await getCollection('work')).map(story => ({params:{slug:story.id},props:{story}}));
}
interface Props { story: CollectionEntry<'work'>; }
const { story } = Astro.props;
const { Content } = await render(story);
---
<Base title={`${story.data.title} — Sudharsana`} description={story.data.subtitle}>
  <article class="story wrap">
    <a class="text-link" href="/#work">← Back to selected work</a>
    <header class="story-header"><p class="eyebrow">{story.data.group === 'professional' ? 'Professional work' : 'Personal explorations'} · {story.data.category}</p><h1>{story.data.title}</h1><p class="large-prose">{story.data.subtitle}</p><p class="small-note">{story.data.evidenceLabel}</p></header>
    <figure class={`story-art surface-${story.data.illustration}`}><WorkArt kind={story.data.illustration}/><figcaption>{story.data.caption}</figcaption></figure>
    {story.data.metrics.length > 0 && <dl class="story-metrics">{story.data.metrics.map(metric => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>}
    <div class="story-body"><Content/><aside class="evidence-note"><h2>Follow the evidence</h2><p>{story.data.evidenceNote}</p>{story.data.source ? <a class="text-link" href={story.data.source}>{story.data.sourceLabel} ↗</a> : <p class="small-note">{story.data.sourceLabel}</p>}</aside></div>
    <div class="story-end"><p>Good systems start with good questions.</p><a class="text-link" href="/#connect">Let’s talk ↗</a></div>
  </article>
</Base>
