---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkArt from '../components/WorkArt.astro';
import Workbench from '../components/Workbench.astro';
import ProfessionalWork from '../components/ProfessionalWork.astro';
import CareerJourney from '../components/CareerJourney.astro';
import portrait from '../assets/portrait.webp';
import { site, careerScale, approach } from '../content/site';
const notes = (await getCollection('notes')).sort((a,b) => a.data.order - b.data.order);
const stories = (await getCollection('work')).sort((a,b) => a.data.order - b.data.order);
const professional = stories.filter(story => story.data.group === 'professional');
const personal = stories.filter(story => story.data.group === 'personal');
const chapters = (await getCollection('experience')).sort((a,b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-spark" aria-hidden="true">✳</span> Data foundations. Applied AI. Human curiosity.</p>
      <h1 id="hero-title">{site.headline.map((line,index) => <>{index > 0 && <br/>}{line.lead}<em>{line.emphasis}</em></>)}</h1>
      <p class="hero-intro">{site.introduction}</p>
      <div class="hero-actions"><a class="button" href="#work">Explore my work <span aria-hidden="true">↘</span></a><a class="hero-secondary" href="#experience">The longer story ↓</a></div>
    </div>
    <figure class="hero-portrait">
      <svg class="portrait-orbit" viewBox="0 0 460 490" aria-hidden="true"><path d="M22 208C-8 80 94 26 230 18s231 55 205 160-1 184-113 232S52 337 22 208Z" fill="none" stroke="#17211B" stroke-width="1.5" stroke-dasharray="6 8"/></svg>
      <div class="portrait-frame"><Image src={portrait} alt="Sudharsana Rajasekaran" widths={[320,480,640]} sizes="(max-width: 740px) 80vw, 380px" width={480} height={478} format="webp" loading="eager" fetchpriority="high" /></div>
      <svg class="portrait-spark" viewBox="0 0 120 120" aria-hidden="true"><path d="M60 3l11 34 30-20-20 31 36 12-36 12 20 31-30-20-11 34-11-34-30 20 20-31L3 60l36-12-20-31 30 20Z" fill="#F58B70" stroke="#17211B" stroke-width="2"/><circle cx="60" cy="60" r="15" fill="#F5F1E8" stroke="#17211B" stroke-width="2"/></svg>
      <div class="portrait-note">Hello, I’m Sudharsana.<span aria-hidden="true">↖</span></div>
      <figcaption>Engineer. Builder. Always a student.</figcaption>
    </figure>
  </section>
  <section class="wrap career-scale" aria-label="The scale of my professional work"><p class="scale-intro">A little context<br/>for the work.</p><dl>{careerScale.map(metric => <div><dt>{metric.label}</dt><dd>{metric.value}</dd><dd class="scale-context">{metric.context}</dd></div>)}</dl></section>
  <section class="curiosity wrap section-space" aria-labelledby="curiosity-title">
    <div><p class="eyebrow">Currently following</p><h2 id="curiosity-title">What happens<br/><em>around</em> the model?</h2></div>
    <p class="large-prose">{site.curiosity}</p>
  </section>
  <ProfessionalWork stories={professional}/>
  <section id="lab" class="wrap section-space personal-section" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">From my own workbench</p><h2 id="work-title">Selected <em>work.</em></h2></div><p>A place to follow a question.<br/>And leave the decisions in.</p></div>
    <div class="personal-grid">{personal.map(story => <article class="personal-card"><figure class={`work-figure surface-${story.data.illustration}`}><WorkArt kind={story.data.illustration}/><figcaption>{story.data.displayLabel}</figcaption></figure><div class="work-copy"><p class="eyebrow">{story.data.category}</p><h3><a href={`/work/${story.id}/`}>{story.data.title}</a></h3><p>{story.data.summary}</p><a class="text-link" href={`/work/${story.id}/`}>Explore the story <span aria-hidden="true">↗</span></a></div></article>)}</div>
  </section>
  <section class="wrap section-space approach-section" aria-labelledby="approach-title"><div class="section-heading"><div><p class="eyebrow">How I approach the work</p><h2 id="approach-title">From the first question<br/>to the <em>hard parts.</em></h2></div><span class="approach-spark" aria-hidden="true">✳</span></div><ol class="approach-grid">{approach.map(step => <li><span class="approach-number" aria-hidden="true">{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></section>
  <section class="inference-section section-space" aria-labelledby="inference-title"><div class="wrap inference-grid"><div class="inference-copy"><p class="eyebrow">A little interactive detour</p><h2 id="inference-title">Same model.<br/>Different <em>journeys.</em></h2><p>Inference has more than one moving part. Follow a request, then change the conditions around it.</p><p class="small-note">Choose a scenario. Each change plays once, then settles.</p></div><Workbench/></div></section>
  <section id="notes" class="wrap section-space" aria-labelledby="notes-title"><div class="section-heading"><div><p class="eyebrow">Thinking out loud</p><h2 id="notes-title">Notes from<br/>the <em>workbench.</em></h2></div><a class="text-link" href={site.blog}>Visit the blog <span aria-hidden="true">↗</span></a></div><div class="notes-grid">{notes.map(({data:note}) => <article class="note"><time datetime={note.date}>{new Date(note.date + 'T00:00:00Z').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><h3><a href={note.url}>{note.title}<span aria-hidden="true">↗</span></a></h3><p>{note.summary}</p></article>)}</div></section>
  <section id="about" class="wrap about section-space" aria-labelledby="about-title"><div class="about-shape" aria-hidden="true"><svg viewBox="0 0 300 300"><rect x="60" y="40" width="180" height="210" rx="90" fill="#D6EB77" stroke="#17211B" stroke-width="2" transform="rotate(-15 150 150)"/><circle cx="117" cy="130" r="8" fill="#17211B"/><circle cx="180" cy="114" r="8" fill="#17211B"/><path d="M127 171q35 30 58-15" fill="none" stroke="#17211B" stroke-width="3" stroke-linecap="round"/><path d="M21 70l-5-18M30 60l9-15M38 75l21-4" stroke="#17211B" stroke-width="2"/><circle cx="244" cy="234" r="29" fill="#F58B70" stroke="#17211B" stroke-width="2"/><path d="M232 234h24M244 222v24" stroke="#17211B" stroke-width="2"/></svg><p>A person behind the pixels.</p></div><div><p class="eyebrow">A little about me</p><h2 id="about-title">Serious about the work.<br/><em>Curious</em> about everything.</h2><p>{site.biography}</p><p class="career-paragraph">{site.career}</p></div></section>
  <CareerJourney chapters={chapters}/>
  <section id="connect" class="wrap invitation section-space" aria-labelledby="connect-title"><p class="eyebrow">Have an interesting problem?</p><h2 id="connect-title">Let’s make<br/>something <em>useful.</em><span class="invite-spark" aria-hidden="true">✳</span></h2><div class="invitation-bottom"><p>I’d love to talk about AI systems,<br/>engineering, and what you’re building.</p><a class="button" href={site.linkedin}>Connect on LinkedIn <span aria-hidden="true">↗</span></a></div><div class="social-links"><a href={site.github}>GitHub ↗</a><a href={site.blog}>Blog ↗</a></div></section>
</Base>
<script>
  import '../scripts/art-preview';
</script>
