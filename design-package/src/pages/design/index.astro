---
import Base from '../../layouts/Base.astro';
import { inferenceStates } from '../../content/inference';
import { getCollection } from 'astro:content';
const stories = (await getCollection('work')).sort((a,b) => a.data.group.localeCompare(b.data.group) || a.data.order - b.data.order);
const swatches = [{name:'Paper',hex:'#F5F1E8'},{name:'Ink',hex:'#17211B'},{name:'Leaf lime',hex:'#D6EB77'},{name:'Cobalt',hex:'#2448C6'},{name:'Coral',hex:'#F58B70'}];
---
<Base title="The studio — Sudharsana"><div class="wrap design-page">
  <p class="eyebrow">Inside the studio</p><h1>A playful studio for<br/><em>serious engineering.</em></h1>
  <p>A space for the things I build and the questions behind them. The visual language draws on paper, simple geometry, and a little curiosity.</p>
  <div class="design-links"><a class="button" href="/">Explore the homepage ↗</a><a class="text-link" href="/work/ai-chat/">Explore the chat system ↗</a></div>
  <section class="design-block"><h2>The palette</h2><div class="swatches">{swatches.map(color => <div class="swatch"><div class="swatch-color" style={`background:${color.hex}`}></div><p>{color.name}<br/>{color.hex}</p></div>)}</div><p class="small-note">Paper and ink set the tone. Lime and coral carry illustrations. Cobalt makes actions and focus visible.</p></section>
  <section class="design-block"><h2>The type</h2><div class="type-samples"><div><p class="eyebrow">Space Grotesk · 400 / 600</p><h3>Clear thinking.<br/>Useful systems.</h3><p>Body copy at 18px, with space to read. Headings are confident; the words do the work.</p></div><div><p class="eyebrow">Instrument Serif · italic</p><h3><em>Curiosity, with intention.</em></h3><p>Used for a few expressive words, leaving the main narrative clear and direct.</p></div></div></section>
  <section class="design-block"><h2>The inference sketch</h2><p>Follow a request through the model, then change the conditions around it. A busy queue and a shared beginning reveal different choices about waiting, computation, and reuse.</p><div class="design-links">{inferenceStates.map(state => <a class="text-link" href={`/design/states/${state.id}/`}>{state.label} ↗</a>)}</div></section>
  <section class="design-block"><h2>Seven stories to explore</h2><div class="design-links">{stories.map(story => <a class="text-link" href={`/work/${story.id}/`}>{story.data.title} ↗</a>)}</div></section>
</div></Base>
