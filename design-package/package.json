{
  "name": "sudharsana-design-package",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:production": "SITE_BUILD_MODE=production SITE_OUTPUT_DIR=../build ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "astro": "7.3.5",
    "motion": "13.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
