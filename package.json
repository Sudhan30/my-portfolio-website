{
  "name": "sudharsana-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "npm --prefix design-package run dev",
    "check": "npm --prefix design-package run check",
    "build": "npm --prefix design-package run build:production && node scripts/prepare-hosting.mjs",
    "test": "node scripts/validate-production.mjs",
    "preview": "SITE_ROOT=build node design-package/scripts/serve.mjs",
    "test:browser": "npm --prefix design-package run test:browser"
  }
}
