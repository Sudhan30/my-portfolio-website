{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": true,
    "cleanUrls": false,
    "redirects": [
      {
        "source": "/work/text-to-sql",
        "destination": "/work/ai-chat/",
        "type": 301
      },
      {
        "source": "/work/text-to-sql/",
        "destination": "/work/ai-chat/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' 'sha256-avBsHJG3rpkfyu8n2VjYnVSBKroEYQF0ECMW2UL2jzI=' 'sha256-msdUbUFJKwCl5cD4lU89ysHxs6fqhTGvup+Y7z6WVZ8=' 'sha256-4YJ2joj+3giYOnCa2gUImnn/f7+zbSkYxnvKpQof1hY=' 'sha256-KBkSIOl+y0pqGrJ7SlL7f/i2xioTuW3cnYeVDWUOnfM=' 'sha256-aP8WalL3huCp7KbuEaSpjLTw7tad8X6VQ3mmup1KEak=' 'sha256-PtFNvJZ4uBE3OidYcklfIX0LjSrmOxwPVRBq91vOo68=' 'sha256-qo4RrrOPFya5ozqMBb+ptGrtQM7EqgO9BiW0XHyUESQ=' 'sha256-vPjlZVAMtwaJoGRAq4DS3Nyc89RWK29UI7Qn82DhdS0=' 'sha256-sEw94UKrzr/aPSFTfbnBhEgIH9j+x8l7oHfQdXOBk00='; style-src 'self'; style-src-attr 'none'; font-src 'self'; img-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/work/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/404.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/favicon.svg",
        "headers": [
