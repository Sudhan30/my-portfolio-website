{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": true,
    "cleanUrls": false,
    "redirects": [
      {
        "source": "/work/text-to-sql",
        "destination": "/work/ai-chat/",
        "type": 301
      },
      {
        "source": "/work/text-to-sql/",
        "destination": "/work/ai-chat/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' 'sha256-J0u9XF83Mc5Yg5aQlTm9gx6CtsCYzIfJtagyaadh1Y8=' 'sha256-Ae0ULv4CU5viU+xftBFCtsr3fIkRMPSVwEO/SSq56wA=' 'sha256-Skb8q/YMIquc5al8i3HwJ4OdHIrnCWJc9Cioyx1ZKQc=' 'sha256-cotzwimpDcBa4GKq+EiZuNr61k5i9eyiLFim+PDmDac=' 'sha256-vpuhpbcI1AdyzpfnfiA/0cUNYVKS5MwI3PemM9gYMTw=' 'sha256-A6/IQKgX7CILJ2wjwn4Gye0m9m3Gc4mNZyZ7wpa4iNs=' 'sha256-d4lHrnUVyZPQgDitx0jY1Qd66vLM/M4TxvIDnN0kiDE=' 'sha256-lzL3+YzYJb5GlIIU6k0v15RF2tibS9Ctb5md34THEfg=' 'sha256-LzbaHUGLLv3oRPa/5FTny4KQqEr70ZMs9NQDzGVR2Gw='; style-src 'self'; style-src-attr 'none'; font-src 'self'; img-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
