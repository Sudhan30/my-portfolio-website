{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": true,
    "cleanUrls": false,
    "redirects": [
      {
        "source": "/work/text-to-sql",
        "destination": "/work/ai-chat/",
        "type": 301
      },
      {
        "source": "/work/text-to-sql/",
        "destination": "/work/ai-chat/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' 'sha256-QCcWD+JN2tGPcDC7jl9ULKaLmFw5sAxtyT3t6VVTgC8=' 'sha256-ptlohX5Jk1pNONgdHDaVf5+Hbg22mZP7EArJAPocUS4=' 'sha256-AXoeBG1rCd1Hf97pnfEp1aXnld6nG+5yyUfhw/XzXb4=' 'sha256-sD54la0bTWYi//KsLPnaKeYjoutjcCo1TQAuCiyBjrk=' 'sha256-gKm9we1lZulHasp+Xfk83uJZZ+seWAaXm/Kg/yxZW9k=' 'sha256-dJ4tR6gBSFMdD0l2y89q1aKFTtZjfF4EOPXvpHH6yrM=' 'sha256-VoamWOBfVfVD7vNJ9B6BDNrjaX6NcrQGJK7AW2/cH6I=' 'sha256-MhwdjtjntAGC+fptajuMtxVHDs/VbWLdaoqdaYnrpSU=' 'sha256-gjBsNP+2g4l9ERFVLmGrXfXNIL/uSnuNn+90qDXKTFM='; style-src 'self'; style-src-attr 'none'; font-src 'self'; img-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/work/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/404.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/favicon.svg",
        "headers": [
